# Copie este arquivo para .env e preencha. O .env nunca vai para o Git (está no .gitignore).
# Chave gratuita em https://console.groq.com/keys
GROQ_API_KEY=

# Opcional: outro modelo da Groq com suporte a ferramentas (prefixo "groq/").
# GROQ_MODEL=groq/openai/gpt-oss-20b
# Deixe vazio se o modelo não for de raciocínio.
# GROQ_REASONING_FORMAT=hidden

# Opcional: outro servidor MCP público (HTTP).
# MCP_URL=https://mcp.deepwiki.com/mcp
